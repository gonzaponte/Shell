function extract-frames {
    param(
        [Parameter(Mandatory = $true)]
        [string]$video_file
    )

    $output_dir = "$( [System.IO.Path]::GetFileNameWithoutExtension($video_file) )_frames"

    New-Item -ItemType Directory -Force -Path $output_dir | Out-Null

    ffmpeg -i $video_file "$output_dir\frame_%06d.jpeg"
}
